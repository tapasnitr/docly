{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@docly/config": ["packages/config/src/index.ts"],
      "@docly/types": ["packages/types/src/index.ts"],
      "@docly/logger": ["packages/logger/src/index.ts"],
      "@docly/database": ["packages/database/src/index.ts"],
      "@docly/redis": ["packages/redis/src/index.ts"],
      "@docly/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/dist", "**/.next", "**/build"]
}
