{
  "name": "@docly/api",
  "version": "0.1.0",
  "description": "Fastify REST API for Docly",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --import tsx ./src/index.ts",
    "build": "tsc",
    "start": "node --import tsx ./src/index.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^4.27.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@prisma/client": "^5.13.0",
    "zod": "^3.23.8",
    "@docly/config": "*",
    "@docly/types": "*",
    "@docly/logger": "*",
    "@docly/database": "*",
    "@docly/redis": "*",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^22.0.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0"
  }
}
