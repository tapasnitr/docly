{
  "name": "@docly/api",
  "version": "0.1.0",
  "description": "Fastify REST API for Docly",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --include ../../.env ./src/index.ts",
    "build": "tsc",
    "start": "node --import tsx ./src/index.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@docly/config": "*",
    "@docly/database": "*",
    "@docly/jobs": "*",
    "@docly/rag": "*",
    "@docly/logger": "*",
    "@docly/redis": "*",
    "@docly/storage": "*",
    "@docly/types": "*",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.13.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.27.0",
    "nodemailer": "^10.1.1",
    "tsx": "^4.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.4"
  }
}
