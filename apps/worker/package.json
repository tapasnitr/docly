{
  "name": "@docly/worker",
  "version": "0.1.0",
  "description": "Background job worker for Docly",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --import tsx ./src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "bullmq": "^5.7.0",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "@prisma/client": "^5.13.0",
    "@docly/config": "*",
    "@docly/types": "*",
    "@docly/logger": "*",
    "@docly/database": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0"
  }
}
