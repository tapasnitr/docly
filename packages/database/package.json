{
  "name": "@docly/database",
  "version": "0.1.0",
  "description": "Database setup for Docly",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:prod": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "node --import tsx ./seed.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/bcryptjs": "^2.4.6",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.13.0",
    "tsx": "^4.7.0"
  }
}
