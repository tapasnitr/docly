{
  "name": "@docly/database",
  "version": "0.1.0",
  "description": "Database setup for Docly",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --loader tsx ./seed.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^22.0.0",
    "prisma": "^5.13.0",
    "tsx": "^4.7.0"
  }
}
