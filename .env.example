# Database
# Host-side connection string, for `npm run dev` against the dockerized
# datastores (`docker-compose up -d postgres redis`), which publish these
# ports to localhost. The fully-dockerized flow (`docker-compose up -d`)
# doesn't read this file - api/worker get container-network hostnames
# (postgres/redis) from docker-compose.yml's own `environment:` block instead.
DATABASE_URL="postgresql://docly:docly_password@localhost:5432/docly_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Node environment
NODE_ENV="development"

# API
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated list of allowed origins, or "*" to allow any (dev only -
# set explicit origins in production).
CORS_ORIGIN="*"

# Web
# The API's URL as seen from the BROWSER (apps/web/src/lib/api-client.ts).
# Must use the same hostname the web app itself is served from (localhost) -
# cookies are scoped by hostname, not port, so localhost:3001 and
# localhost:3000 correctly share the auth cookies the API sets; 127.0.0.1:3001
# would not, even though it's the same machine. For the hybrid dev flow
# (`docker-compose up -d postgres redis` + `npm run dev`), the API listens on
# :3001 directly. Only use "http://localhost/api" (port 80) if you're running
# the fully-dockerized flow (`docker-compose up -d` with no service names),
# which routes through nginx instead.
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# The API's URL as seen from the Next.js SERVER's own session check
# (apps/web/src/lib/session.ts) only - never sent to the browser, so it can
# safely differ from NEXT_PUBLIC_API_URL above. Use 127.0.0.1, NOT
# "localhost": Node's server-side `fetch` resolves "localhost" to the IPv6
# loopback (::1) first, but Fastify's API_HOST=0.0.0.0 only binds IPv4, so a
# server-side fetch to "http://localhost:3001" fails with "fetch failed"
# even though the exact same URL works fine from a browser (which falls back
# to IPv4 automatically) or curl.
API_INTERNAL_URL="http://127.0.0.1:3001/api"

# Worker
WORKER_CONCURRENCY=5

# Logging
LOG_LEVEL="debug"

# AWS (placeholder - will be filled in production)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="local"
AWS_SECRET_ACCESS_KEY="local"
AWS_S3_BUCKET="docly-documents"

# JWT (will be generated)
JWT_SECRET="your_jwt_secret_change_in_production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Base URL of the web app - used to build links in emails (verify-email, reset-password)
WEB_APP_URL="http://localhost:3000"

# Email (SMTP). Leave SMTP_HOST blank in dev to log emails to the console.
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS (no spaces).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Docly <you@example.com>"
EMAIL_VERIFICATION_EXPIRY="24h"
PASSWORD_RESET_EXPIRY="1h"

# Login lockout
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION="15m"

# LLM (placeholder)
OPENAI_API_KEY="sk-placeholder"

# Document storage (local disk; defaults to <repo>/storage) and per-upload size cap
# STORAGE_DIR=""
MAX_UPLOAD_MB=10

# RAG / document Q&A (all optional: without keys it runs offline with keyword
# embeddings and returns the matching passages instead of a written answer)
# ANTHROPIC_API_KEY=""       # written, cited answers (streams)
# RAG_CHAT_MODEL="claude-sonnet-5-5"
# OPENAI_API_KEY above also switches embeddings to text-embedding-3-small
