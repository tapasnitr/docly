# Database
# Host-side connection string, for `npm run dev` against the dockerized
# datastores (`docker-compose up -d postgres redis`), which publish these
# ports to localhost. The fully-dockerized flow (`docker-compose up -d`)
# doesn't read this file - api/worker get container-network hostnames
# (postgres/redis) from docker-compose.yml's own `environment:` block instead.
DATABASE_URL="postgresql://docly:docly_password@localhost:5432/docly_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Node environment
NODE_ENV="development"

# API
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated list of allowed origins, or "*" to allow any (dev only -
# set explicit origins in production).
CORS_ORIGIN="*"

# Web
NEXT_PUBLIC_API_URL="http://localhost/api"

# Worker
WORKER_CONCURRENCY=5

# Logging
LOG_LEVEL="debug"

# AWS (placeholder - will be filled in production)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="local"
AWS_SECRET_ACCESS_KEY="local"
AWS_S3_BUCKET="docly-documents"

# JWT (will be generated)
JWT_SECRET="your_jwt_secret_change_in_production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Base URL of the web app - used to build links in emails (verify-email, reset-password)
WEB_APP_URL="http://localhost:3000"

# Email (Resend - https://resend.com/api-keys). Leave blank in dev to log
# emails to the console instead of sending them.
RESEND_API_KEY=""
EMAIL_FROM="Docly <onboarding@resend.dev>"
EMAIL_VERIFICATION_EXPIRY="24h"
PASSWORD_RESET_EXPIRY="1h"

# Login lockout
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION="15m"

# LLM (placeholder)
OPENAI_API_KEY="sk-placeholder"
